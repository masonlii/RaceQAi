# Copy this file to `.env` and fill in the values from your Supabase project.
# (Supabase dashboard -> Project Settings -> API)
#
# The .env file is gitignored and must NEVER be committed.
# Only the ANON (public) key belongs here. NEVER put the service_role
# (secret) key in the frontend -- it would be exposed to every visitor.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
